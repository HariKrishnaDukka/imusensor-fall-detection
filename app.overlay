/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };
};

&uart0 {
    status = "okay";

    current-speed = <1000000>;

    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

&i2c0 {
    status = "okay";

    clock-frequency = <I2C_BITRATE_FAST>;

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {

    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 8)>;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 0, 8)>;
            low-power-enable;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            low-power-enable;
        };
    };
};

/* IMU INT1 pin declaration for Zephyr DT.
 * "gpio-keys" is used here only because it is one of the bindings
 * that correctly declares "gpios" as a phandle-array property so
 * GPIO_DT_SPEC_GET()/DT_NODELABEL() resolve correctly. The
 * gpio-keys DRIVER (zephyr,code, key-press semantics, the
 * INPUT subsystem) is NOT used - this pin is read and configured
 * directly via gpio_pin_*() calls in imu.c. */
/ {
    imu_int1 {
        compatible = "gpio-keys";

        imu_int1_pin: imu_int1_pin {
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        };
    };
};